# nerdui settings for the systemd unit, installed as /etc/default/nerdui.
# Every flag of `nerdui serve` has a NERDUI_* variable; see `nerdui --help`.

# Listen address. Prefer 127.0.0.1 behind an SSH tunnel or a TLS reverse proxy; nerdui grants
# root-equivalent access to the host (SECURITY.md).
NERDUI_LISTEN=:9443

# NERDUI_DATA_DIR=/var/lib/nerdui
# NERDUI_ADDRESS=/run/containerd/containerd.sock
# NERDUI_NAMESPACE=default
# NERDUI_NERDCTL_PATH=/usr/local/bin/nerdctl
# NERDUI_LOG_LEVEL=info

# Own certificate instead of the generated self-signed one (reloaded when the files change):
# NERDUI_TLS_CERT=/etc/nerdui/fullchain.pem
# NERDUI_TLS_KEY=/etc/nerdui/privkey.pem
# Behind a TLS-terminating reverse proxy only:
# NERDUI_TLS=false
