# Version of Telegraf
VERSION=1.40
# Name of the InfluxDB user
INFLUX_USER=admin
# Password of that user, at least 8 characters
INFLUX_PASSWORD=
# InfluxDB organization
INFLUX_ORG=nerdui
# Bucket the metrics go to
INFLUX_BUCKET=telegraf
# API token Telegraf writes with
INFLUX_TOKEN=
# Port of InfluxDB on the host
PORT=8086
