# Version of LobeChat
VERSION=1.143.3
# Access code asked in the web interface
ACCESS_PASSWORD=
# OpenAI API key; leave empty if users enter their own keys
OPENAI_API_KEY=
# Address of an Ollama server, e.g. http://ollama-host:11434; leave empty for none
OLLAMA_PROXY_URL=
# Port of the web interface on the host
PORT=3210
