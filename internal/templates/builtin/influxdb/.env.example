# Major version of InfluxDB
VERSION=2
# Name of the first user
INFLUX_USER=admin
# Password of the first user, at least 8 characters
INFLUX_PASSWORD=
# Organization created at the first start
INFLUX_ORG=nerdui
# Bucket created at the first start
INFLUX_BUCKET=default
# API token of the first user
INFLUX_TOKEN=
# Port on the host
PORT=8086
