# Version of ClickHouse (26.8 is a long-term support release)
VERSION=26.8
# Name of the user
CLICKHOUSE_USER=default
# Password of that user
CLICKHOUSE_PASSWORD=
# Database created at the first start
CLICKHOUSE_DB=app
# HTTP interface port on the host
HTTP_PORT=8123
# Native protocol port on the host
NATIVE_PORT=9000
