# Version of API Firewall
VERSION=0.9.6
# Address of the API behind the firewall
BACKEND=http://127.0.0.1:8080
# What to do with invalid requests: LOG_ONLY, BLOCK or DISABLE
REQUEST_VALIDATION=LOG_ONLY
# What to do with invalid responses: LOG_ONLY, BLOCK or DISABLE
RESPONSE_VALIDATION=LOG_ONLY
# Port on the host
PORT=8139
