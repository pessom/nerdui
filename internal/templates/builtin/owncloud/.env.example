# Version of ownCloud Server
VERSION=10.16
# Host and port the site is opened at
DOMAIN=localhost:8121
# Host names the site is opened at, separated by commas
TRUSTED_DOMAINS=localhost
# Password of the database user
DB_PASSWORD=
# Name of the administrator
ADMIN_USER=admin
# Password of the administrator
ADMIN_PASSWORD=
# Port on the host
PORT=8121
